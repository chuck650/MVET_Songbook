{
  "name": "mvet-songbook",
  "private": true,
  "version": "1.4.3",
  "type": "module",
  "scripts": {
    "sync": "bash .agents/skills/song-catalog-management/scripts/sync-all-songs.sh",
    "push-songbook": "bash .agents/skills/local-testing-and-deployment/scripts/push-songbook.sh",
    "pull-repertoire-state": "node .agents/skills/local-testing-and-deployment/scripts/pull-repertoire-state.cjs",
    "deploy-prod-api": "bash .agents/skills/local-testing-and-deployment/scripts/deploy-prod-api.sh",
